#!/usr/bin/env bash
# =============================================================================
#
#   ushell-box  ::  box  —  a zero-dependency, Bash-native micro-container engine
#
#   Course   : B24EF0506 — UNIX Shell Programming Lab, REVA University
#   Targets  : Ubuntu 24.04 (WSL 2) · Ubuntu 22.04/24.04 (VMware) · x86_64/arm64
#   Needs    : bash >= 4.4, util-linux (unshare, nsenter, setsid, flock),
#              coreutils, curl|wget, tar, gzip — nothing else.
#
#   How a container is born (see README.md for the full diagram):
#
#     box run ──► supervise() ──► cgroup mkdir + limits  (memory.max / cpu.max)
#                     │
#                     └─ ( echo $BASHPID > cgroup.procs ; exec unshare -m -u -i ) &
#                                     │   new mount + UTS + IPC namespaces
#                                     └─► box __init   (host FS, host PID ns)
#                                            ├─ mount overlay  (image = lowerdir)
#                                            ├─ mount sysfs / tmpfs /dev / volumes
#                                            ├─ hostname <name>
#                                            └─ exec unshare --pid ─► reaper
#                                                  └─ fork ─► PID 1 (new PID ns)
#                                                       exec unshare --mount-proc
#                                                       exec chroot <rootfs> <cmd>
#
#   Every mount is made *inside* the container's private mount namespace, so the
#   kernel destroys all of them automatically when the container's last process
#   dies — even if this engine is killed with SIGKILL. Traps then only need to
#   reap cgroups and state, which `box cleanup` can also do after a hard crash.
#
#   Exit codes (deterministic):
#     0  success                 2  permission denied / root missing
#     1  bad arguments / usage   3  runtime or isolation error
#   `box run` in the foreground returns the *container's* exit status instead
#   (e.g. 137 = 128+SIGKILL, which is what an OOM-kill looks like).
#
# =============================================================================

set -Eeuo pipefail
shopt -s nullglob
umask 022

readonly BOX_VERSION="1.0.0"
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF

# ----------------------------------------------------------------------------
#  Configuration (overridable from the environment)
# ----------------------------------------------------------------------------
: "${BOX_ROOT:=/var/lib/ushell-box}"        # image + container state lives here
BOX_ROOT="$(readlink -m -- "$BOX_ROOT")"
: "${BOX_STOP_GRACE:=5}"                    # seconds between SIGTERM and SIGKILL
: "${BOX_PIDS_MAX:=512}"                    # default fork-bomb guard (pids.max)
: "${BOX_ROOTFS_MODE:=auto}"                # auto | overlay | copy
: "${BOX_CGROUP:=auto}"                     # auto | v2 | v1 | none

readonly IMAGES_DIR="$BOX_ROOT/images"
readonly CONTAINERS_DIR="$BOX_ROOT/containers"
readonly TMP_DIR="$BOX_ROOT/tmp"
readonly CG_PARENT="ushell-box"
readonly JAIL_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

readonly E_OK=0 E_USAGE=1 E_PERM=2 E_RUNTIME=3

# Pinned fallback used only if the Alpine release index cannot be parsed.
readonly ALPINE_PIN_BRANCH="v3.24"
readonly ALPINE_PIN_FILE="alpine-minirootfs-3.24.4-x86_64.tar.gz"
readonly ALPINE_PIN_SHA256="cdaa38cb8de3537967ee5b6c9b6cd00cc962da2b018e6eea48696bb274923012"

ORIG_ARGS=()
CG_VERSION=0          # 2, 1 or 0 (none) — set by cg_detect
CG_BASE="/sys/fs/cgroup"

# chroot, mount, … live in sbin; make sure they resolve even for odd PATHs.
case ":$PATH:" in *:/usr/sbin:*) ;; *) PATH="$PATH:/usr/sbin:/sbin" ;; esac
export PATH

# =============================================================================
#  §1  Presentation: colours & logging
#      stdout carries *data* (tables, ids); stderr carries *diagnostics* (>&2)
# =============================================================================
setup_colors() {
    if [[ -t 2 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
        C_RST=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
        C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YEL=$'\033[33m'
        C_BLU=$'\033[34m' C_MAG=$'\033[35m' C_CYN=$'\033[36m'
    else
        C_RST='' C_B='' C_DIM='' C_RED='' C_GRN='' C_YEL='' C_BLU='' C_MAG='' C_CYN=''
    fi
}

info() { [[ ${BOX_QUIET:-0} == 1 ]] || printf '%s▸%s %s\n' "$C_BLU$C_B" "$C_RST" "$*" >&2; }
ok()   { [[ ${BOX_QUIET:-0} == 1 ]] || printf '%s✔%s %s\n' "$C_GRN$C_B" "$C_RST" "$*" >&2; }
warn() { printf '%s⚠ warning:%s %s\n' "$C_YEL$C_B" "$C_RST" "$*" >&2; }
err()  { printf '%s✖ error:%s %s\n'   "$C_RED$C_B" "$C_RST" "$*" >&2; }
die()  { local code=$1; shift; err "$*"; exit "$code"; }

need_val() { [[ $# -ge 2 && -n $2 ]] || die "$E_USAGE" "option '$1' requires a value"; }

# =============================================================================
#  §2  Signal handling & defensive cleanup
#      Cleanup actions are pushed on a LIFO stack and run exactly once from the
#      EXIT / INT / TERM / HUP traps, so a Ctrl+C at any moment unwinds cleanly.
# =============================================================================
_CLEANUP=()
_IN_CLEANUP=0
_EXIT_SIGNAL=""
_EXIT_RC=0

cleanup_push() { _CLEANUP+=("$(printf '%q ' "$@")"); }

cleanup() {
    local rc=$?
    local sig=${1:-EXIT}
    (( _IN_CLEANUP )) && return 0
    _IN_CLEANUP=1
    trap '' INT TERM HUP                      # don't let a 2nd Ctrl+C abort teardown
    _EXIT_RC=$rc
    [[ $sig != EXIT ]] && { _EXIT_SIGNAL=$sig; printf '\n' >&2; warn "caught SIG$sig — cleaning up"; }
    local i
    for (( i = ${#_CLEANUP[@]} - 1; i >= 0; i-- )); do
        eval "${_CLEANUP[i]}" || true
    done
    _CLEANUP=()
    case $sig in INT) rc=130 ;; TERM) rc=143 ;; HUP) rc=129 ;; esac
    trap - EXIT
    exit "$rc"
}

install_traps() {
    trap 'cleanup EXIT' EXIT
    trap 'cleanup INT'  INT
    trap 'cleanup TERM' TERM
    trap 'cleanup HUP'  HUP
}

# =============================================================================
#  §3  Privilege handling
# =============================================================================
require_root() {
    (( EUID == 0 )) && return 0
    if command -v sudo >/dev/null 2>&1 && { [[ -t 0 ]] || sudo -n true 2>/dev/null; }; then
        info "'box $1' needs root (namespaces, mounts, cgroups) — re-executing via sudo"
        exec sudo --preserve-env=BOX_ROOT,BOX_STOP_GRACE,BOX_PIDS_MAX,BOX_ROOTFS_MODE,BOX_CGROUP,BOX_QUIET,BOX_DEBUG,NO_COLOR,TERM \
            "$BASH" "$SELF" "${ORIG_ARGS[@]}"
    fi
    die "$E_PERM" "'box $1' must run as root — try: sudo $SELF ${ORIG_ARGS[*]}"
}

# True when we are root only inside a user namespace (rootless test mode).
in_userns() {
    local a b c
    read -r a b c < /proc/self/uid_map 2>/dev/null || return 1
    [[ ! ($a == 0 && $b == 0 && $c == 4294967295) ]]
}

# =============================================================================
#  §4  Small utilities
# =============================================================================
gen_id() { od -An -N6 -tx1 /dev/urandom | tr -d ' \n'; }

# "50M" → 52428800. Accepts K/M/G with optional "i"/"B" suffix, or raw bytes.
parse_size() {
    local s=${1^^}
    [[ $s =~ ^([0-9]+)([KMG]?)I?B?$ ]] || return 1
    local n=${BASH_REMATCH[1]} u=${BASH_REMATCH[2]}
    case $u in
        K) n=$(( n * 1024 )) ;;
        M) n=$(( n * 1024 * 1024 )) ;;
        G) n=$(( n * 1024 * 1024 * 1024 )) ;;
    esac
    printf '%s\n' "$n"
}

limit_h() { # bytes|"" [fallback] → "50.0MiB" or the fallback word
    if [[ -n ${1:-} ]]; then human "$1"; else printf '%s\n' "${2:-max}"; fi
}

human() {   # bytes → "12.3MiB"
    [[ ${1:-} =~ ^[0-9]+$ ]] || { printf '%s\n' "${1:--}"; return 0; }
    awk -v b="$1" 'BEGIN { split("B KiB MiB GiB TiB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d%s\n" : "%.1f%s\n"), b, u[i] }'
}

duration() {  # seconds → "42s" / "7m" / "3h" / "2d"
    local s=$1
    if   (( s < 60 ));    then printf '%ss\n' "$s"
    elif (( s < 3600 ));  then printf '%sm\n' $(( s / 60 ))
    elif (( s < 86400 )); then printf '%sh\n' $(( s / 3600 ))
    else                       printf '%sd\n' $(( s / 86400 ))
    fi
}

# Field 22 of /proc/<pid>/stat (start time) — guards against PID reuse.
proc_starttime() {
    local s
    { s=$(< "/proc/$1/stat"); } 2>/dev/null || return 1
    local -a f
    read -ra f <<< "${s##*) }"
    printf '%s\n' "${f[19]}"
}

fs_type() { stat -fc %T -- "$1" 2>/dev/null || printf 'unknown\n'; }

init_dirs() {
    mkdir -p "$IMAGES_DIR" "$CONTAINERS_DIR" "$TMP_DIR"
    chmod 0711 "$BOX_ROOT" 2>/dev/null || true
    case $(fs_type "$BOX_ROOT") in
        9p|v9fs|fuseblk|drvfs)
            warn "BOX_ROOT=$BOX_ROOT is on a Windows/9p filesystem; chroot, overlayfs and"
            warn "unix permissions misbehave there. Use the default /var/lib/ushell-box." ;;
    esac
}

# =============================================================================
#  §5  Container state store
#      $BOX_ROOT/containers/<id>/config  — KEY=VALUE lines (never `source`d)
#      $BOX_ROOT/containers/<id>/cmd     — argv, NUL-separated
#      $BOX_ROOT/containers/<id>/volumes — host:ctr[:ro] per line
# =============================================================================
cdir_of()  { printf '%s/%s\n' "$CONTAINERS_DIR" "$1"; }

state_get() {   # id KEY → value (empty if unset)
    local f="$CONTAINERS_DIR/$1/config"
    [[ -f $f ]] || return 0
    K="$2" awk -F= '$1 == ENVIRON["K"] { sub(/^[^=]*=/, ""); print; exit }' "$f"
}

state_set() {   # id KEY VALUE [KEY VALUE ...]  — atomic (tmp + mv) under flock
    local id=$1; shift
    local dir="$CONTAINERS_DIR/$id" upd="" k v
    [[ -d $dir ]] || return 0
    while (( $# >= 2 )); do
        k=$1 v=${2//$'\n'/ }
        upd+="$k=$v"$'\n'
        shift 2
    done
    {
        flock -w 5 9 || true
        [[ -f $dir/config ]] || : > "$dir/config"
        UPD="$upd" awk -F= '
            BEGIN {
                n = split(ENVIRON["UPD"], L, "\n")
                for (i = 1; i <= n; i++) if (L[i] != "") {
                    k = L[i]; sub(/=.*/, "", k)
                    v = L[i]; sub(/^[^=]*=/, "", v)
                    if (!(k in nv)) order[++m] = k
                    nv[k] = v
                }
            }
            ($1 in nv) { if (!($1 in seen)) print $1 "=" nv[$1]; seen[$1] = 1; next }
            { print }
            END { for (i = 1; i <= m; i++) if (!(order[i] in seen)) print order[i] "=" nv[order[i]] }
        ' "$dir/config" > "$dir/config.tmp" && mv -f "$dir/config.tmp" "$dir/config"
    } 9> "$dir/.lock" || true
}

container_ids() {
    local d
    for d in "$CONTAINERS_DIR"/*/; do
        [[ -f $d/config ]] && basename "$d"
    done
    return 0
}

resolve_container() {   # name | id | unique id-prefix → id
    local q=${1:-} id n
    local -a hits=()
    [[ -n $q ]] || die "$E_USAGE" "a container name or id is required"
    while read -r id; do
        [[ -n $id ]] || continue
        n=$(state_get "$id" NAME)
        if [[ $n == "$q" || $id == "$q" ]]; then printf '%s\n' "$id"; return 0; fi
        [[ $id == "$q"* ]] && hits+=("$id")
    done < <(container_ids)
    case ${#hits[@]} in
        1) printf '%s\n' "${hits[0]}" ;;
        0) die "$E_USAGE" "no such container: '$q'  (see: box ps -a)" ;;
        *) die "$E_USAGE" "id prefix '$q' is ambiguous: ${hits[*]}" ;;
    esac
}

is_running() {
    local pid st cur
    pid=$(state_get "$1" INIT_PID)
    [[ $pid =~ ^[0-9]+$ && -d /proc/$pid ]] || return 1
    st=$(state_get "$1" INIT_START)
    [[ -z $st ]] && return 0
    cur=$(proc_starttime "$pid") || return 1
    [[ $cur == "$st" ]]
}

# =============================================================================
#  §6  cgroups — v2 unified hierarchy first, v1 per-controller fallback
# =============================================================================
cg_detect() {
    CG_VERSION=0
    case $BOX_CGROUP in
        none) return 0 ;;
        v2)   CG_VERSION=2; return 0 ;;
        v1)   CG_VERSION=1; return 0 ;;
    esac
    if [[ $(fs_type "$CG_BASE") == cgroup2fs ]]; then
        CG_VERSION=2                                   # pure unified hierarchy
    elif [[ -d $CG_BASE/memory && $(fs_type "$CG_BASE/memory") == cgroupfs ]]; then
        CG_VERSION=1                                   # legacy or hybrid layout
    fi
    return 0
}

cg_dirs() {     # id → one cgroup directory per line
    case $CG_VERSION in
        2) printf '%s\n' "$CG_BASE/$CG_PARENT/$1" ;;
        1) local c
           for c in memory cpu pids; do
               [[ -d $CG_BASE/$c ]] && printf '%s\n' "$CG_BASE/$c/$CG_PARENT/$1"
           done ;;
    esac
    return 0
}

cg_dir_for() {  # id controller → directory that holds that controller's files
    case $CG_VERSION in
        2) printf '%s\n' "$CG_BASE/$CG_PARENT/$1" ;;
        1) printf '%s\n' "$CG_BASE/$2/$CG_PARENT/$1" ;;
    esac
}

cg_write() {    # file value — quiet, returns non-zero on failure
    { printf '%s\n' "$2" > "$1"; } 2>/dev/null
}

cg_read() {     # file → first line (empty if unreadable)
    local v=""
    { read -r v < "$1"; } 2>/dev/null || true
    printf '%s\n' "$v"
}

cg_create() {   # id mem_bytes cpu_pct pids_max
    local id=$1 mem=$2 cpu=$3 pids=$4 c d
    case $CG_VERSION in
    2)
        local parent="$CG_BASE/$CG_PARENT"
        mkdir -p "$parent" 2>/dev/null || return 1
        # Controllers must be delegated top-down via cgroup.subtree_control.
        for c in memory cpu pids; do
            grep -qw "$c" "$CG_BASE/cgroup.controllers" 2>/dev/null || continue
            grep -qw "$c" "$CG_BASE/cgroup.subtree_control" 2>/dev/null ||
                cg_write "$CG_BASE/cgroup.subtree_control" "+$c" || true
            grep -qw "$c" "$parent/cgroup.subtree_control" 2>/dev/null ||
                cg_write "$parent/cgroup.subtree_control" "+$c" || true
        done
        mkdir "$parent/$id" 2>/dev/null || return 1
        d="$parent/$id"
        if [[ -n $mem ]]; then
            cg_write "$d/memory.max" "$mem" || { warn "cannot write memory.max"; return 1; }
            cg_write "$d/memory.swap.max" 0 || true        # no swap: cap is the real cap
        fi
        if [[ -n $cpu ]]; then
            cg_write "$d/cpu.max" "$(( cpu * 1000 )) 100000" || { warn "cannot write cpu.max"; return 1; }
        fi
        [[ -n $pids ]] && { cg_write "$d/pids.max" "$pids" || true; }
        ;;
    1)
        while read -r d; do mkdir -p "$d" 2>/dev/null || return 1; done < <(cg_dirs "$id")
        if [[ -n $mem ]]; then
            d=$(cg_dir_for "$id" memory)
            cg_write "$d/memory.limit_in_bytes" "$mem" || { warn "cannot write memory.limit_in_bytes"; return 1; }
            cg_write "$d/memory.memsw.limit_in_bytes" "$mem" || true
            cg_write "$d/memory.swappiness" 0 || true
        fi
        if [[ -n $cpu ]]; then
            d=$(cg_dir_for "$id" cpu)
            cg_write "$d/cpu.cfs_period_us" 100000 || true
            cg_write "$d/cpu.cfs_quota_us" "$(( cpu * 1000 ))" || { warn "cannot write cpu.cfs_quota_us"; return 1; }
        fi
        if [[ -n $pids && -d $CG_BASE/pids ]]; then
            cg_write "$(cg_dir_for "$id" pids)/pids.max" "$pids" || true
        fi
        ;;
    *) return 1 ;;
    esac
    return 0
}

cg_procs() {    # id → PIDs currently in the container's cgroup
    local d
    d=$(cg_dir_for "$1" memory) || return 0
    [[ -n $d && -r $d/cgroup.procs ]] && cat -- "$d/cgroup.procs" 2>/dev/null
    return 0
}

cg_mem_current() {
    case $CG_VERSION in
        2) cg_read "$(cg_dir_for "$1" memory)/memory.current" ;;
        1) cg_read "$(cg_dir_for "$1" memory)/memory.usage_in_bytes" ;;
    esac
}

cg_mem_peak() {
    case $CG_VERSION in
        2) cg_read "$(cg_dir_for "$1" memory)/memory.peak" ;;
        1) cg_read "$(cg_dir_for "$1" memory)/memory.max_usage_in_bytes" ;;
    esac
}

cg_oom_kills() {
    local f
    case $CG_VERSION in
        2) f="$(cg_dir_for "$1" memory)/memory.events" ;;
        1) f="$(cg_dir_for "$1" memory)/memory.oom_control" ;;
        *) printf '0\n'; return 0 ;;
    esac
    [[ -r $f ]] || { printf '0\n'; return 0; }
    awk '$1 == "oom_kill" { print $2; found = 1 } END { if (!found) print 0 }' "$f"
}

cg_cpu_usec() {
    local d
    case $CG_VERSION in
        2) d=$(cg_dir_for "$1" cpu)
           [[ -r $d/cpu.stat ]] && awk '$1 == "usage_usec" { print $2 }' "$d/cpu.stat" ;;
        1) d=$(cg_dir_for "$1" cpu)
           [[ -r $d/cpuacct.usage ]] && awk '{ printf "%d\n", $1 / 1000 }' "$d/cpuacct.usage" ;;
    esac
    return 0
}

cg_destroy() {  # id — kill stragglers, then rmdir every controller directory
    local id=$1 d p i
    while read -r d; do
        [[ -n $d && -d $d ]] || continue
        if [[ -s $d/cgroup.procs ]]; then
            cg_write "$d/cgroup.kill" 1 || true         # v2, kernel >= 5.14
            while read -r p; do kill -KILL "$p" 2>/dev/null || true; done 2>/dev/null < "$d/cgroup.procs"
        fi
        for (( i = 0; i < 30; i++ )); do
            rmdir "$d" 2>/dev/null && break
            sleep 0.1
        done
        if [[ -d $d ]]; then warn "could not remove cgroup $d"; fi
    done < <(cg_dirs "$id")
    return 0
}

# =============================================================================
#  §7  Image management  (box pull / images / rmi)
# =============================================================================
fetch() {       # url dest — curl preferred, wget fallback
    local -a progress=(-sS)
    [[ -t 2 ]] && progress=(--progress-bar)
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 20 "${progress[@]}" -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        if [[ -t 2 ]]; then wget -q --show-progress -O "$2" "$1"; else wget -q -O "$2" "$1"; fi
    else
        die "$E_RUNTIME" "neither curl nor wget is installed"
    fi
}

fetch_stdout() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 2 --connect-timeout 20 "$1"
    else
        wget -qO- "$1"
    fi
}

# Resolve an image name to:  PULL_URL  PULL_SHA256  PULL_VERSION
resolve_alpine() {
    local arch
    case $(uname -m) in
        x86_64)        arch=x86_64 ;;
        aarch64|arm64) arch=aarch64 ;;
        armv7l)        arch=armv7 ;;
        *) die "$E_RUNTIME" "unsupported architecture $(uname -m)" ;;
    esac
    local base="${BOX_ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine}"
    local idx="$base/latest-stable/releases/$arch"
    local yaml="" file="" sha=""
    info "querying Alpine release index ($arch)…"
    yaml=$(fetch_stdout "$idx/latest-releases.yaml" 2>/dev/null) || yaml=""
    if [[ -n $yaml ]]; then
        read -r file sha < <(awk '
            /flavor: *alpine-minirootfs/ { f = 1 }
            f && $1 == "file:"   { file = $2 }
            f && $1 == "sha256:" { print file, $2; exit }' <<< "$yaml") || true
    fi
    if [[ -n $file && -n $sha ]]; then
        PULL_URL="$idx/$file"
    elif [[ $arch == x86_64 ]]; then
        warn "release index unavailable — using pinned $ALPINE_PIN_FILE"
        file=$ALPINE_PIN_FILE sha=$ALPINE_PIN_SHA256
        PULL_URL="$base/$ALPINE_PIN_BRANCH/releases/x86_64/$file"
    else
        die "$E_RUNTIME" "could not read the Alpine release index"
    fi
    PULL_SHA256=$sha
    PULL_VERSION=$(sed -E 's/^alpine-minirootfs-(.*)-[^-]+\.tar\.gz$/\1/' <<< "$file")
}

resolve_ubuntu() {
    local arch
    case $(uname -m) in
        x86_64)        arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) die "$E_RUNTIME" "unsupported architecture $(uname -m)" ;;
    esac
    local base="https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release"
    local sums line
    info "querying Ubuntu Base 24.04 checksums ($arch)…"
    sums=$(fetch_stdout "$base/SHA256SUMS") || die "$E_RUNTIME" "cannot download $base/SHA256SUMS"
    line=$(grep -E "ubuntu-base-24\.04(\.[0-9]+)?-base-$arch\.tar\.gz$" <<< "$sums" | sort -V -k2 | tail -n1) ||
        true
    [[ -n $line ]] || die "$E_RUNTIME" "no ubuntu-base tarball for $arch in SHA256SUMS"
    local file=${line##*[ *]}
    PULL_SHA256=${line%% *}
    PULL_URL="$base/$file"
    PULL_VERSION=$(sed -E 's/^ubuntu-base-(.*)-base-.*$/\1/' <<< "$file")
}

cmd_pull() {
    local image=alpine force=0
    while (( $# )); do
        case $1 in
            -f|--force) force=1; shift ;;
            -h|--help)  printf 'usage: box pull [--force] [alpine|ubuntu-mini]\n'; return 0 ;;
            -*) die "$E_USAGE" "unknown option '$1' for pull" ;;
            *)  image=$1; shift ;;
        esac
    done
    case $image in
        alpine)                 resolve_alpine ;;
        ubuntu-mini|ubuntu)     image=ubuntu-mini; resolve_ubuntu ;;
        *) die "$E_USAGE" "unknown image '$image' (available: alpine, ubuntu-mini)" ;;
    esac

    local dest="$IMAGES_DIR/$image"
    if [[ -d $dest/rootfs && $force -eq 0 ]]; then
        ok "image '$image' already present ($(state_meta "$image" VERSION)) — use --force to re-pull"
        return 0
    fi

    local work
    work=$(mktemp -d "$TMP_DIR/pull.XXXXXX")
    cleanup_push rm -rf --one-file-system -- "$work"
    local tarball="$work/${PULL_URL##*/}"

    info "downloading ${PULL_URL##*/}"
    fetch "$PULL_URL" "$tarball" || die "$E_RUNTIME" "download failed: $PULL_URL"

    info "verifying SHA-256…"
    local got
    got=$(sha256sum -- "$tarball" | cut -d' ' -f1)
    [[ $got == "$PULL_SHA256" ]] || die "$E_RUNTIME" "checksum mismatch! expected $PULL_SHA256, got $got"
    ok "checksum OK ($got)"

    info "extracting root filesystem…"
    mkdir -p "$work/image/rootfs"
    local -a tar_opts=(--numeric-owner -xpzf)
    if in_userns; then
        warn "running inside a user namespace — file ownership will not be preserved"
        tar_opts=(--no-same-owner -xzf)
    fi
    tar "${tar_opts[@]}" "$tarball" -C "$work/image/rootfs" ||
        die "$E_RUNTIME" "tar extraction failed"

    # Here-document: image metadata, written in one shot.
    cat > "$work/image/image.meta" <<EOF
NAME=$image
VERSION=$PULL_VERSION
ARCH=$(uname -m)
SOURCE=$PULL_URL
SHA256=$PULL_SHA256
PULLED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    if [[ -d $dest ]]; then
        local id
        while read -r id; do
            [[ -n $id && $(state_get "$id" IMAGE) == "$image" ]] || continue
            if is_running "$id"; then
                die "$E_RUNTIME" "image '$image' is in use by running container $(state_get "$id" NAME)"
            fi
        done < <(container_ids)
        rm -rf --one-file-system -- "$dest"
    fi
    mv -- "$work/image" "$dest"
    local files size
    files=$(find "$dest/rootfs" -xdev | wc -l)
    size=$(du -sh -- "$dest/rootfs" | cut -f1)
    ok "pulled '$image' $PULL_VERSION → $dest/rootfs  ($size, $files files)"
}

state_meta() { awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$IMAGES_DIR/$1/image.meta" 2>/dev/null || true; }

cmd_images() {
    local d name
    printf '%s%-12s %-10s %-8s %-7s %-10s %-19s %s%s\n' "$C_B" NAME VERSION ARCH SIZE INODE PULLED PATH "$C_RST"
    for d in "$IMAGES_DIR"/*/; do
        [[ -d $d/rootfs ]] || continue
        name=$(basename "$d")
        # stat -c: %i = inode number, %y = last modification time
        printf '%-12s %-10s %-8s %-7s %-10s %-19s %s\n' \
            "$name" "$(state_meta "$name" VERSION)" "$(state_meta "$name" ARCH)" \
            "$(du -sh -- "$d/rootfs" 2>/dev/null | cut -f1)" \
            "$(stat -c '%i' -- "$d/rootfs")" \
            "$(stat -c '%y' -- "$d/rootfs" | cut -d. -f1)" "${d%/}/rootfs"
    done
}

cmd_rmi() {
    (( $# )) || die "$E_USAGE" "usage: box rmi <image>"
    local image=$1 id
    [[ -d $IMAGES_DIR/$image ]] || die "$E_USAGE" "no such image: $image"
    while read -r id; do
        [[ $(state_get "$id" IMAGE) == "$image" ]] || continue
        is_running "$id" && die "$E_RUNTIME" "image in use by running container $(state_get "$id" NAME)"
    done < <(container_ids)
    rm -rf --one-file-system -- "${IMAGES_DIR:?}/$image"
    ok "removed image '$image'"
}

image_present() { [[ -d $IMAGES_DIR/$1/rootfs ]]; }

# =============================================================================
#  §8  Container lifecycle — host side (supervisor)
# =============================================================================
overlay_usable() {
    grep -qw overlay /proc/filesystems 2>/dev/null || modprobe overlay 2>/dev/null || true
    grep -qw overlay /proc/filesystems 2>/dev/null || return 1
    case $(fs_type "$BOX_ROOT") in overlayfs|9p|v9fs|fuseblk|nfs|tmpfs) return 1 ;; esac
    return 0
}

prepare_rootfs() {      # id image
    local id=$1 cdir lower mode=$BOX_ROOTFS_MODE
    cdir=$(cdir_of "$id")
    lower="$IMAGES_DIR/$2/rootfs"
    [[ -d $lower ]] || die "$E_RUNTIME" "image rootfs missing: $lower"
    if [[ $mode == auto ]]; then
        if overlay_usable; then mode=overlay; else mode=copy; fi
    fi
    case $mode in
        overlay)
            mkdir -p "$cdir/upper" "$cdir/work" "$cdir/merged"
            state_set "$id" ROOTFS_MODE overlay ROOTFS "$cdir/merged" LOWER "$lower" ;;
        copy)
            info "overlayfs unavailable — copying image into a private rootfs"
            mkdir -p "$cdir/rootfs"
            cp -a -- "$lower/." "$cdir/rootfs/"
            state_set "$id" ROOTFS_MODE copy ROOTFS "$cdir/rootfs" LOWER "$lower" ;;
        *) die "$E_USAGE" "BOX_ROOTFS_MODE must be auto, overlay or copy" ;;
    esac
}

# The container's PID 1 is the child that `unshare --fork` creates. Find it and
# confirm it really lives in a different PID namespace than we do.
find_ns_child() {
    local parent=$1 me c ns i
    me=$(readlink /proc/self/ns/pid)
    for (( i = 0; i < 200; i++ )); do
        kill -0 "$parent" 2>/dev/null || return 1
        c=""
        { read -r c _ < "/proc/$parent/task/$parent/children"; } 2>/dev/null || true
        [[ -z $c ]] && c=$(pgrep -P "$parent" 2>/dev/null | head -n1) || true
        if [[ -n $c ]]; then
            ns=$(readlink "/proc/$c/ns/pid" 2>/dev/null) || ns=""
            if [[ -n $ns && $ns != "$me" ]]; then printf '%s\n' "$c"; return 0; fi
        fi
        sleep 0.05
    done
    return 1
}

record_exit() {         # id rc — capture accounting *before* the cgroup is removed
    local id=$1 rc=$2 oom peak name
    [[ -d $(cdir_of "$id") ]] || return 0
    [[ $(state_get "$id" STATUS) == exited ]] && return 0
    oom=$(cg_oom_kills "$id"); oom=${oom:-0}
    peak=$(cg_mem_peak "$id")
    name=$(state_get "$id" NAME)
    state_set "$id" STATUS exited EXIT_CODE "$rc" FINISHED "$(date +%s)" \
        OOM_KILLED "$(( oom > 0 ? 1 : 0 ))" MEM_PEAK "${peak:-}"
    if (( oom > 0 )); then
        warn "container '$name' was OOM-killed by the cgroup memory controller" \
             "(limit $(human "$(state_get "$id" MEM_BYTES)"), peak $(human "$peak"), exit $rc)"
    elif (( rc > 128 )); then
        info "container '$name' terminated by SIG$(kill -l $(( rc - 128 )) 2>/dev/null || echo '?') (exit $rc)"
    else
        info "container '$name' exited with code $rc"
    fi
}

kill_container() {      # id grace_seconds — SIGTERM, wait, then SIGKILL
    local id=$1 grace=${2:-$BOX_STOP_GRACE} pid i
    is_running "$id" || return 0
    pid=$(state_get "$id" INIT_PID)
    info "SIGTERM → container init (host PID $pid), grace ${grace}s"
    kill -TERM "$pid" 2>/dev/null || true
    for (( i = 0; i < grace * 10; i++ )); do
        is_running "$id" || { ok "container exited gracefully"; return 0; }
        sleep 0.1
    done
    (( grace > 0 )) && warn "still alive after ${grace}s (PID 1 ignores signals it has no handler for)"
    info "SIGKILL → host PID $pid (kill -9 is always delivered from the parent namespace)"
    kill -KILL "$pid" 2>/dev/null || true
    for (( i = 0; i < 50; i++ )); do
        is_running "$id" || return 0
        sleep 0.1
    done
    warn "init PID $pid survived SIGKILL?!"
    return 1
}

# Unmount anything under <dir> that is visible in *our* mount table. Normally
# there is nothing (all mounts live in the container's namespace) — this is the
# belt-and-braces guard before any rm -rf.
sweep_mounts() {
    local dir=$1 m
    local -a mps=()
    mapfile -t mps < <(D="$dir" awk '$2 == ENVIRON["D"] || index($2, ENVIRON["D"] "/") == 1 { print $2 }' /proc/mounts | sort -r)
    for m in "${mps[@]}"; do
        m=$(printf '%b' "$m")                       # /proc/mounts escapes spaces as \040
        umount -l -- "$m" 2>/dev/null && warn "lazily unmounted leftover $m"
    done
    return 0
}

remove_container_dir() {
    local id=$1 cdir
    cdir=$(cdir_of "$id")
    [[ -d $cdir ]] || return 0
    sweep_mounts "$cdir"
    if awk -v d="$cdir/" 'index($2 "/", d) == 1 { found = 1 } END { exit !found }' /proc/mounts; then
        die "$E_RUNTIME" "refusing to delete $cdir: something is still mounted under it"
    fi
    rm -rf --one-file-system -- "$cdir"
}

# Idempotent: safe to call from the supervisor's trap, from `box stop`, from
# `box rm -f` and from `box cleanup`, in any order, any number of times.
container_teardown() {  # id
    local id=$1 shim rc=""
    [[ -f $(cdir_of "$id")/config ]] || return 0
    if is_running "$id"; then kill_container "$id" 2 || true; fi
    shim=$(state_get "$id" SHIM_PID)
    if [[ $shim =~ ^[0-9]+$ && $(state_get "$id" SUPERVISOR_PID) == "$$" ]]; then
        wait "$shim" 2>/dev/null && rc=0 || rc=$?
        [[ $rc == 127 ]] && rc=""                     # already reaped
    fi
    if [[ $(state_get "$id" STATUS) != exited ]]; then
        if [[ -z $rc ]]; then
            if [[ -n $_EXIT_SIGNAL || $(state_get "$id" STATUS) == running ]]; then rc=137; else rc=$_EXIT_RC; fi
        fi
        record_exit "$id" "$rc"
    fi
    cg_destroy "$id"
    sweep_mounts "$(cdir_of "$id")"
    [[ $(state_get "$id" AUTO_REMOVE) == 1 ]] && remove_container_dir "$id"
    return 0
}

# Runs the container to completion. Used directly by foreground `box run` and
# via `box __supervise` (in a setsid'd background process) for `box run -d`.
supervise() {
    local id=$1 name image mem cpu pids rc=0 f
    name=$(state_get "$id" NAME)
    image=$(state_get "$id" IMAGE)
    mem=$(state_get "$id" MEM_BYTES)
    cpu=$(state_get "$id" CPU_PCT)
    pids=$(state_get "$id" PIDS_MAX)
    state_set "$id" SUPERVISOR_PID "$$"
    cleanup_push container_teardown "$id"

    prepare_rootfs "$id" "$image"

    # ---- 1. cgroup: create + limits (before the container exists) --------
    local -a procs_files=()
    if (( CG_VERSION > 0 )) && cg_create "$id" "$mem" "$cpu" "$pids"; then
        while read -r f; do procs_files+=("$f/cgroup.procs"); done < <(cg_dirs "$id")
        state_set "$id" CGROUP "$(cg_dirs "$id" | paste -sd, -)" CG_VERSION "$CG_VERSION"
        info "cgroup v$CG_VERSION: memory=$(limit_h "$mem" unlimited)" \
             "cpu=${cpu:-unlimited}${cpu:+%} pids=${pids:-max}"
    elif [[ -n $mem || -n $cpu ]]; then
        die "$E_RUNTIME" "cgroups unavailable (version=$CG_VERSION) — cannot enforce --mem/--cpu"
    else
        warn "cgroups unavailable — running without resource accounting"
        state_set "$id" CG_VERSION 0
    fi

    # ---- 2. namespaces: fork a shim, join the cgroup, exec unshare --------
    #   stage 1 (here):        unshare --mount --uts --ipc  → box __init (setup)
    #   stage 2 (in __init):   unshare --pid                → reaper → PID 1
    local -a ns_flags=(--mount --uts --ipc --propagation private)
    local -a sigreset=()
    env --default-signal=INT true 2>/dev/null && sigreset=(env --default-signal=INT,QUIT,PIPE)
    info "unshare --mount --uts --ipc → setup → unshare --pid → chroot $(state_get "$id" ROOTFS)"
    (
        # builtins only between fork and exec: the cgroup is inherited by
        # every descendant, so the limits apply from the very first instruction
        for f in "${procs_files[@]}"; do
            printf '%s\n' "$BASHPID" > "$f" || exit "$E_RUNTIME"
        done
        exec "${sigreset[@]}" unshare "${ns_flags[@]}" -- "$BASH" "$SELF" __init "$id"
    ) <&0 &
    local shim=$!
    state_set "$id" SHIM_PID "$shim" STATUS running STARTED "$(date +%s)"

    local init_pid=""
    if init_pid=$(find_ns_child "$shim"); then
        state_set "$id" INIT_PID "$init_pid" INIT_START "$(proc_starttime "$init_pid" || true)"
        ok "container '$name' (${id}) running — host PID $init_pid ⇄ container PID 1"
    fi

    # ---- 3. wait (interruptible: the INT/TERM traps fire immediately) -----
    wait "$shim" || rc=$?
    record_exit "$id" "$rc"
    return "$rc"
}

# =============================================================================
#  §9  Container lifecycle — inside the namespaces (PID 1, before chroot)
# =============================================================================
jail_path_ok() {    # root path → succeed if path resolves inside root
    local r
    r=$(realpath -m -- "$2") || return 1
    [[ $r == "$1" || $r == "$1"/* ]]
}

jail_write() {      # root /abs/path content
    local t="$1$2"
    jail_path_ok "$1" "${t%/*}" || { warn "skipping $2 (escapes rootfs)"; return 0; }
    [[ -L $t ]] && rm -f -- "$t"
    mkdir -p -- "${t%/*}"
    printf '%s\n' "$3" > "$t"
}

setup_dev() {       # minimal /dev: tmpfs + a few bind-mounted device nodes
    local r=$1 d
    mount -t tmpfs -o nosuid,mode=0755,size=4m tmpfs "$r/dev" || die "$E_RUNTIME" "cannot mount tmpfs on /dev"
    for d in null zero full random urandom tty; do
        [[ -e /dev/$d ]] || continue
        : > "$r/dev/$d"
        mount --bind "/dev/$d" "$r/dev/$d" || warn "bind /dev/$d failed"
    done
    ln -s /proc/self/fd   "$r/dev/fd"
    ln -s /proc/self/fd/0 "$r/dev/stdin"
    ln -s /proc/self/fd/1 "$r/dev/stdout"
    ln -s /proc/self/fd/2 "$r/dev/stderr"
    mkdir -p "$r/dev/pts" "$r/dev/shm"
    if mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$r/dev/pts" 2>/dev/null; then
        ln -s pts/ptmx "$r/dev/ptmx"
    fi
    mount -t tmpfs -o nosuid,nodev,mode=1777 shm "$r/dev/shm" 2>/dev/null || true
}

mount_volume() {    # root host:ctr[:ro]
    local root=$1 hp cp mode t
    IFS=: read -r hp cp mode <<< "$2"
    t="$root$cp"
    jail_path_ok "$root" "$t" || die "$E_RUNTIME" "volume target $cp escapes the rootfs via a symlink"
    [[ -L $t ]] && die "$E_RUNTIME" "volume target $cp is a symlink — refusing"
    if [[ -d $hp ]]; then
        mkdir -p -- "$t"
    else
        mkdir -p -- "${t%/*}"
        [[ -e $t ]] || : > "$t"
    fi
    mount --bind -- "$hp" "$t" || die "$E_RUNTIME" "bind-mount $hp → $cp failed"
    if [[ ${mode:-rw} == ro ]]; then
        mount -o remount,bind,ro -- "$t" || die "$E_RUNTIME" "cannot make $cp read-only"
    fi
}

container_init() {
    local id=${1:?} cdir name mode root lower v
    cdir=$(cdir_of "$id")
    [[ $(readlink /proc/self/ns/mnt) != "$(readlink /proc/1/ns/mnt)" ]] ||
        die "$E_RUNTIME" "__init must run inside a private mount namespace"
    name=$(state_get "$id" NAME)
    mode=$(state_get "$id" ROOTFS_MODE)
    root=$(state_get "$id" ROOTFS)
    lower=$(state_get "$id" LOWER)
    local -a cmd=() vols=()
    mapfile -d '' -t cmd < "$cdir/cmd"
    [[ -s $cdir/volumes ]] && mapfile -t vols < "$cdir/volumes"

    # Mount events must never propagate back to the host.
    mount --make-rprivate / 2>/dev/null || true

    # 1. root filesystem: copy-on-write overlay (image stays pristine)
    case $mode in
        overlay) mount -t overlay overlay \
                     -o "lowerdir=$lower,upperdir=$cdir/upper,workdir=$cdir/work" "$root" ||
                     die "$E_RUNTIME" "overlay mount failed — retry with BOX_ROOTFS_MODE=copy" ;;
        copy)    mount --bind "$root" "$root" || die "$E_RUNTIME" "bind mount of rootfs failed" ;;
        *)       die "$E_RUNTIME" "unknown rootfs mode '$mode'" ;;
    esac
    mkdir -p "$root/proc" "$root/sys" "$root/dev" "$root/tmp" "$root/etc"

    # 2. /proc is mounted at the very end, by PID 1 itself (see step 7):
    #    a procfs instance belongs to the PID namespace of whoever mounts it.

    # 3. sysfs (read-only); fall back to a read-only bind of the host's /sys
    if ! mount -t sysfs -o ro,nosuid,nodev,noexec sysfs "$root/sys" 2>/dev/null; then
        if mount --rbind /sys "$root/sys" 2>/dev/null; then
            mount -o remount,bind,ro "$root/sys" 2>/dev/null || true
        else
            warn "/sys is not available inside the container"
        fi
    fi

    # 4. /dev
    setup_dev "$root"

    # 5. identity: UTS hostname + /etc files (written into the overlay upper)
    hostname "$name" 2>/dev/null ||
        { printf '%s\n' "$name" > /proc/sys/kernel/hostname; } 2>/dev/null ||
        warn "could not set the container hostname"
    jail_write "$root" /etc/hostname "$name"
    jail_write "$root" /etc/hosts "127.0.0.1	localhost
::1	localhost ip6-localhost
127.0.1.1	$name"
    [[ -r /etc/resolv.conf ]] && jail_write "$root" /etc/resolv.conf "$(< /etc/resolv.conf)"

    # 6. volumes
    for v in "${vols[@]}"; do mount_volume "$root" "$v"; done

    # 7. PID namespace + jail.
    #    `unshare --pid` (without --fork) moves only our *future children* into
    #    the new namespace; the first one we fork becomes PID 1. So a tiny
    #    reaper shell that forks exactly once launches an exec-only chain:
    #       [reset signals] → [pdeathsig] → unshare --mount-proc → env -i → chroot → cmd
    #    Nothing in that chain forks, so the user's command *is* PID 1, procfs is
    #    mounted from inside the new PID namespace, and the reaper's `wait`
    #    reports the real exit status (128+N when killed by signal N).
    cd -- "$root"
    local chroot_bin; chroot_bin=$(command -v chroot)
    local -a chain=()
    if env --default-signal=INT true 2>/dev/null; then
        chain+=(env --default-signal=INT,QUIT,TERM,HUP,PIPE)
    fi
    if command -v setpriv >/dev/null 2>&1; then
        chain+=(setpriv --pdeathsig KILL)       # reaper dies → container dies
    fi
    chain+=(unshare --mount-proc="$root/proc" --
            env -i "PATH=$JAIL_PATH" "HOME=/root" "TERM=${TERM:-xterm}"
                "HOSTNAME=$name" "container=ushell-box" "PS1=[$name \\W]\\$ "
                "$chroot_bin" "$root" "${cmd[@]}")
    unset BASH_ENV ENV
    exec unshare --pid -- "$BASH" --norc --noprofile -c '
        trap "" INT QUIT TERM HUP
        "$@" <&0 &
        wait "$!" 2>/dev/null
        exit "$?"' box-reaper "${chain[@]}"
}

